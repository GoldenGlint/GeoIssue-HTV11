# Copy to spikes/.env and fill in. Never commit spikes/.env.
MAPILLARY_TOKEN=
GEMINI_API_KEY=
# Unused until the Step 3 go/no-go on paid scraping
APIFY_TOKEN=
# Large data (reference images) and model weights. C: is nearly full, so point these at D:
GEOISSUE_DATA_DIR=D:\geoissue\data
GEOISSUE_CACHE_DIR=D:\geoissue\cache
# Optional overrides, set after the smoke test confirms which IDs your key can use
GEMINI_MODEL_FLASH=gemini-3.8-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
