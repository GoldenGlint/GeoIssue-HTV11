# Copy to .env (gitignored) and fill in. Read by scripts/serve.py and the analysis pipeline.
GEMINI_API_KEY=
# Optional: override the model (default: [stages.summaries].model in analysis/config.toml).
# GEMINI_MODEL=
# Optional Tiger Cloud PostgreSQL URI. Server-side only; enable the import with python -m analysis --tiger.
# Example: postgresql://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require
TIGER_DATABASE_URL=
# Optional: Locate with Claude (Claude Code on this computer; see README). Defaults shown.
# GEOLOC_PYTHON=research/geoloc_tests/.venv/Scripts/python.exe
# GEOLOC_MODEL=opus
# GEOLOC_EFFORT=high
# GEOLOC_MINUTES=10
# GEOLOC_MAX_RUNNING=1
