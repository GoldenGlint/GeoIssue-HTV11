[Unit]
Description=GeoIssue ingestion (one bounded run)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=geoissue
Group=geoissue
WorkingDirectory=/opt/geoissue
EnvironmentFile=/etc/geoissue/env
ExecStart=/opt/geoissue/.venv/bin/python scripts/ingest.py
TimeoutStartSec=45min
Nice=10
NoNewPrivileges=true
