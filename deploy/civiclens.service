[Unit]
Description=CivicLens web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=civiclens
Group=civiclens
WorkingDirectory=/opt/civiclens
EnvironmentFile=/etc/civiclens/env
ExecStart=/opt/civiclens/.venv/bin/python scripts/serve.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
