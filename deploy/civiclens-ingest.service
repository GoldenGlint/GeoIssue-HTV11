[Unit]
Description=CivicLens ingestion (one bounded run)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=civiclens
Group=civiclens
WorkingDirectory=/opt/civiclens
EnvironmentFile=/etc/civiclens/env
ExecStart=/opt/civiclens/.venv/bin/python scripts/ingest.py
TimeoutStartSec=45min
Nice=10
NoNewPrivileges=true
